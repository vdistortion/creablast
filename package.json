{
  "name": "creablast",
  "version": "1.0.0",
  "packageManager": "npm@11.10.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build && cd dist/creablast/browser && cp index.html 404.html",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "serve:ssr:creablast": "node dist/creablast/server/server.mjs",
    "public": "npm run build && gh-pages -d dist/creablast/browser --nojekyll --cname creablast.ru",
    "format": "prettier --write src"
  },
  "private": true,
  "dependencies": {
    "@angular/common": "^21.2.0",
    "@angular/compiler": "^21.2.0",
    "@angular/core": "^21.2.0",
    "@angular/forms": "^21.2.0",
    "@angular/platform-browser": "^21.2.0",
    "@angular/platform-server": "^21.2.0",
    "@angular/router": "^21.2.0",
    "@angular/ssr": "^21.2.0",
    "@angular/youtube-player": "^21.2.0",
    "express": "^5.1.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^21.2.0",
    "@angular/cli": "^21.2.0",
    "@angular/compiler-cli": "^21.2.0",
    "@types/express": "^5.0.1",
    "@types/node": "^20.17.19",
    "gh-pages": "^6.3.0",
    "prettier": "3.8.1",
    "smart-grid": "^2.3.2",
    "tsx": "^4.21.0",
    "typescript": "~5.9.2"
  }
}
